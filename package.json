{
  "name": "cross-border-data-hub",
  "version": "0.1.11",
  "private": true,
  "description": "LinkVue 联视 - 跨境全链路可视化数据中台 (Windows 桌面应用)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron .",
    "desktop:export": "cross-env DESKTOP_BUILD=1 next build",
    "desktop:pack": "bash scripts/build-desktop.sh",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.cbh.crossborderhub",
    "productName": "LinkVue 联视",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "electron"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "zwh9820-rgb",
        "repo": "-",
        "releaseType": "release"
      }
    ],
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app/out",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "electron/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LinkVue 联视"
    },
    "portable": {
      "artifactName": "LinkVue联视-便携版-${version}.exe"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.9",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.8.0",
    "maplibre-gl": "^5.2.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^2.15.1",
    "three": "^0.172.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.172.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "33.2.0",
    "electron-builder": "25.1.8",
    "postcss": "^8.5.1",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
